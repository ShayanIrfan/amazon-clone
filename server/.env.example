# Express API (server/). Real values go in server/.env, which is git-ignored.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — local for now; swap for the Atlas mongodb+srv:// string later
MONGODB_URI=mongodb://127.0.0.1:27017/amazon-clone?replicaSet=rs0&directConnection=true

# Signs the httpOnly session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe test mode (dashboard.stripe.com/test/apikeys). Placeholder values = built-in mock payments.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Email delivery. `log` is safe for local development and prints test OTPs.
# Use `send` with a Resend API key and verified sender/domain for real delivery.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=re_TEST_PLACEHOLDER_REPLACE_ME
RESEND_FROM_EMAIL=no-reply@example.test
RESEND_FROM_NAME=amazon-clone
OTP_SECRET=change-me-to-a-long-random-otp-secret
